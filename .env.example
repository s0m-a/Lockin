
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:yourpassword@your-rds-host.rds.amazonaws.com:5432/timetable


DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000

JWT_ACCESS_SECRET=replace_with_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_byte_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000
